CREATE OR REPLACE FUNCTION fc_calcular_horas_trabalhadas_mes(p_colab integer, p_ano integer, p_mes integer)
RETURNS numeric LANGUAGE sql STABLE AS $$
    SELECT ROUND(COALESCE(SUM(fn_minutos_dia(p_colab, d::date)), 0) / 60.0, 2)
      FROM generate_series(make_date(p_ano, p_mes, 1)::timestamp,
                           (make_date(p_ano, p_mes, 1) + interval '1 month - 1 day')::timestamp,
                           interval '1 day') d
$$;

CREATE OR REPLACE FUNCTION fc_calcular_horas_extras_periodo(p_colab integer, p_inicio date, p_fim date)
RETURNS numeric LANGUAGE plpgsql STABLE AS $$
DECLARE v_min bigint;
BEGIN
    IF p_fim < p_inicio THEN
        RAISE EXCEPTION 'Data final (%) anterior à inicial (%).', p_fim, p_inicio;
    END IF;
    SELECT COALESCE(SUM(fn_minutos_extras_dia(p_colab, d::date)), 0) INTO v_min
      FROM generate_series(p_inicio::timestamp, p_fim::timestamp, interval '1 day') d;
    RETURN ROUND(v_min / 60.0, 2);
END $$;

CREATE OR REPLACE FUNCTION fc_verificar_inconsistencia_marcacao(p_colab integer, p_data date)
RETURNS boolean LANGUAGE plpgsql STABLE AS $$
DECLARE v_qtd integer; v_trab integer;
BEGIN
    SELECT count(*) INTO v_qtd
      FROM marcacao_ponto
     WHERE colaborador_id = p_colab
       AND data_hora >= p_data AND data_hora < p_data + 1;

    IF v_qtd = 0 THEN RETURN false; END IF;          
    IF v_qtd % 2 = 1 THEN RETURN true; END IF;       

    IF EXISTS (SELECT 1 FROM fn_pares_dia(p_colab, p_data)
                WHERE EXTRACT(EPOCH FROM (saida - entrada)) / 60 > 360) THEN
        RETURN true;                                
    END IF;

    SELECT COALESCE(SUM(EXTRACT(EPOCH FROM (saida - entrada)) / 60), 0) INTO v_trab
      FROM fn_pares_dia(p_colab, p_data);
    RETURN v_trab > 600;                             
END $$;

CREATE OR REPLACE FUNCTION fc_obter_saldo_banco_horas(p_colab integer, p_data date DEFAULT current_date)
RETURNS integer LANGUAGE sql STABLE AS $$
    SELECT COALESCE(SUM(minutos), 0)::int
      FROM banco_horas_mov
     WHERE colaborador_id = p_colab AND data_ref <= p_data
$$;
CREATE OR REPLACE FUNCTION fc_calcular_adicional_noturno(p_colab integer, p_inicio date, p_fim date)
RETURNS numeric LANGUAGE plpgsql STABLE AS $$
DECLARE v_min_relogio numeric;
BEGIN
    IF p_fim < p_inicio THEN
        RAISE EXCEPTION 'Data final (%) anterior à inicial (%).', p_fim, p_inicio;
    END IF;

    SELECT COALESCE(SUM(EXTRACT(EPOCH FROM (LEAST(p.saida, w.fim) - GREATEST(p.entrada, w.ini))) / 60), 0)
      INTO v_min_relogio
      FROM generate_series(p_inicio::timestamp, p_fim::timestamp, interval '1 day') dia
     CROSS JOIN LATERAL fn_pares_dia(p_colab, dia::date) p
     CROSS JOIN LATERAL (VALUES
            (dia::date - 1 + time '22:00', dia::date     + time '05:00'),
            (dia::date     + time '22:00', dia::date + 1 + time '05:00')
        ) AS w(ini, fim)
     WHERE LEAST(p.saida, w.fim) > GREATEST(p.entrada, w.ini);

    RETURN ROUND(v_min_relogio / 52.5, 2);         
