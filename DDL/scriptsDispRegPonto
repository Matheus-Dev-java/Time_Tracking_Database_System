-- Dispositivo / Coletor
CREATE TABLE dispositivo (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    tipo_dispositivo VARCHAR(20) NOT NULL,
    uuid_identificador VARCHAR(36) NOT NULL UNIQUE,
    ativo BOOLEAN NOT NULL DEFAULT TRUE,
    
    CONSTRAINT chk_tipo_dispositivo CHECK (tipo_dispositivo IN ('mobile', 'web', 'totem', 'rep_c'))
);

-- Batida de Ponto
CREATE TABLE registro_ponto (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    id_dispositivo BIGINT NOT NULL,
    nsr BIGINT NOT NULL UNIQUE,
    data_hora_utc TIMESTAMP NOT NULL,
    latitude DECIMAL(10, 8),
    longitude DECIMAL(11, 8),
    url_foto VARCHAR(255),
    hash_assinatura VARCHAR(256) NOT NULL,
    
    CONSTRAINT fk_registro_ponto_dispositivo FOREIGN KEY (id_dispositivo) REFERENCES dispositivo(id)
);
