CREATE OR REPLACE FUNCTION trg_bloqueia_periodo_fechado() RETURNS trigger
LANGUAGE plpgsql AS $$
DECLARE v_data date;
BEGIN
    IF TG_TABLE_NAME = 'marcacao_ponto' THEN
        v_data := NEW.data_hora::date;
    ELSE
        v_data := NEW.data_ref;
    END IF;

    IF EXISTS (SELECT 1 FROM espelho_ponto e
                WHERE e.colaborador_id = NEW.colaborador_id
                  AND e.ano = EXTRACT(YEAR  FROM v_data)
                  AND e.mes = EXTRACT(MONTH FROM v_data)
                  AND e.fechado) THEN
        RAISE EXCEPTION 'Período %/% do colaborador % está fechado; alteração bloqueada.',
            EXTRACT(MONTH FROM v_data), EXTRACT(YEAR FROM v_data), NEW.colaborador_id;
    END IF;
    RETURN NEW;
END $$;

CREATE TRIGGER tg_marcacao_periodo BEFORE INSERT OR UPDATE ON marcacao_ponto
    FOR EACH ROW EXECUTE FUNCTION trg_bloqueia_periodo_fechado();
CREATE TRIGGER tg_abono_periodo BEFORE INSERT OR UPDATE ON abono
    FOR EACH ROW EXECUTE FUNCTION trg_bloqueia_periodo_fechado();
