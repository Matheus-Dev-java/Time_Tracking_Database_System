CREATE OR REPLACE FUNCTION fn_distancia_m(lat1 double precision, lon1 double precision,
                                          lat2 double precision, lon2 double precision)
RETURNS double precision LANGUAGE sql IMMUTABLE AS $$
    SELECT 2 * 6371000 * asin(sqrt(
        power(sin(radians(lat2 - lat1) / 2), 2) +
        cos(radians(lat1)) * cos(radians(lat2)) * power(sin(radians(lon2 - lon1) / 2), 2)))
$$;

CREATE OR REPLACE FUNCTION fn_carga_prevista_dia(p_colab integer, p_data date)
RETURNS integer LANGUAGE sql STABLE AS $$
    SELECT COALESCE((
        SELECT e.carga_diaria_min
          FROM colaborador_escala ce
          JOIN escala_trabalho e ON e.id = ce.escala_id
         WHERE ce.colaborador_id = p_colab
           AND ce.data_inicio <= p_data
           AND (ce.data_fim IS NULL OR ce.data_fim >= p_data)
           AND EXTRACT(ISODOW FROM p_data)::int = ANY (e.dias_semana)
         ORDER BY ce.data_inicio DESC LIMIT 1), 0)
$$;

CREATE OR REPLACE FUNCTION fn_intervalo_previsto_dia(p_colab integer, p_data date)
RETURNS integer LANGUAGE sql STABLE AS $$
    SELECT COALESCE((
        SELECT e.intervalo_min
          FROM colaborador_escala ce
          JOIN escala_trabalho e ON e.id = ce.escala_id
         WHERE ce.colaborador_id = p_colab
           AND ce.data_inicio <= p_data
           AND (ce.data_fim IS NULL OR ce.data_fim >= p_data)
         ORDER BY ce.data_inicio DESC LIMIT 1), 0)
$$;

CREATE OR REPLACE FUNCTION fn_pares_dia(p_colab integer, p_data date)
RETURNS TABLE (entrada timestamp, saida timestamp) LANGUAGE sql STABLE AS $$
    WITH m AS (
        SELECT data_hora, row_number() OVER (ORDER BY data_hora) AS rn
          FROM marcacao_ponto
         WHERE colaborador_id = p_colab
           AND data_hora >= p_data AND data_hora < p_data + 1
    )
    SELECT e.data_hora, s.data_hora
      FROM m e JOIN m s ON s.rn = e.rn + 1
     WHERE e.rn % 2 = 1
$$;

CREATE OR REPLACE FUNCTION fn_minutos_dia(p_colab integer, p_data date)
RETURNS integer LANGUAGE plpgsql STABLE AS $$
DECLARE v_pares integer; v_total integer;
BEGIN
    SELECT count(*), COALESCE(SUM(EXTRACT(EPOCH FROM (saida - entrada)) / 60), 0)::int
      INTO v_pares, v_total
      FROM fn_pares_dia(p_colab, p_data);

    IF v_pares = 1 AND v_total > 360 THEN
        v_total := v_total - fn_intervalo_previsto_dia(p_colab, p_data);
    END IF;
    RETURN GREATEST(v_total, 0);
END $$;

CREATE OR REPLACE FUNCTION fn_minutos_extras_dia(p_colab integer, p_data date)
RETURNS integer LANGUAGE plpgsql STABLE AS $$
DECLARE v_dif integer;
BEGIN
    v_dif := fn_minutos_dia(p_colab, p_data) - fn_carga_prevista_dia(p_colab, p_data);
    IF v_dif <= 10 THEN RETURN 0; END IF;
    RETURN v_dif;
END $$;

CREATE OR REPLACE FUNCTION fn_minutos_devidos_mes(p_colab integer, p_ano integer, p_mes integer)
RETURNS integer LANGUAGE plpgsql STABLE AS $$
DECLARE
    v_ini date := make_date(p_ano, p_mes, 1);
    v_fim date := (make_date(p_ano, p_mes, 1) + interval '1 month - 1 day')::date;
    v_res integer;
BEGIN
    SELECT COALESCE(SUM(GREATEST(0,
               c.carga
             - fn_minutos_dia(p_colab, c.d)
             - COALESCE((SELECT SUM(a.minutos) FROM abono a
                          WHERE a.colaborador_id = p_colab AND a.data_ref = c.d
                            AND a.status = 'APROVADO'), 0))), 0)::int
      INTO v_res
      FROM (SELECT x::date AS d, fn_carga_prevista_dia(p_colab, x::date) AS carga
              FROM generate_series(v_ini::timestamp, LEAST(v_fim, current_date)::timestamp,
                                   interval '1 day') x) c
     WHERE c.carga > 0;
    RETURN v_res;
END $$;
