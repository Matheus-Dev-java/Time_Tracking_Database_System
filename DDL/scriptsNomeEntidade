postgres
CREATE TYPE adjustment_type_enum AS ENUM (
    'inclusao','desconsideracao'
);
CREATE TYPE adjustment_status_enum AS ENUM (
    'pendente','aprovado', 'reprovado'
);
CREATE TYPE absence_status_enum AS ENUM (
    'pendente','aprovado','reprovado'
);
CREATE TABLE punch_adjustments (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT NOT NULL,
    adjusted_timestamp TIMESTAMP WITH TIME ZONE NOT NULL,
    adjustment_type adjustment_type_enum NOT NULL,
    reason TEXT NOT NULL,
    status adjustment_status_enum NOT NULL DEFAULT 'pendente',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_punch_adjustments_user
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);
CREATE TABLE absences (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT NOT NULL,
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    absence_type VARCHAR(50) NOT NULL,
    cid_code VARCHAR(10),
    document_url VARCHAR(2048),
    status absence_status_enum NOT NULL DEFAULT 'pendente',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_absences_user
        FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    CONSTRAINT chk_absence_dates
        CHECK (end_date >= start_date)
);
CREATE INDEX idx_punch_adjustments_user_status
    ON punch_adjustments (user_id, status);

CREATE INDEX idx_absences_user_dates
    ON absences (user_id, start_date, end_date);
